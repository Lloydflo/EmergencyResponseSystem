## Database configuration
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=ers_db
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

## One-time setup token for /api/setup_database.php
# Change this to a strong random value before running setup
SETUP_TOKEN=change-me-strong-token

## Optional: bootstrap admin user on setup
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin123

## Gemini API (already defaults in code, but can override here)
# GEMINI_API_KEY=
# GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta/models/gemini-2.0-flash:generateContent
# ERS environment configuration
# Copy this file to .env and set real values in production

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=ers_db
DB_USER=ers_user
DB_PASS=your-strong-password
DB_CHARSET=utf8mb4

# Optional: override Gemini API key if needed
# GEMINI_API_KEY=your-gemini-api-key
