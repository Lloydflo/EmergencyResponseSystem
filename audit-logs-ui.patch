+
+.audit-dialog-footer {
+    display: flex;
+    justify-content: flex-end;
+    padding: 0.8rem 1.2rem;
+    border-top: 1px solid var(--audit-border);
+    background: var(--audit-surface-subtle);
+}
+
+html.audit-dialog-is-open,
+html.audit-dialog-is-open body {
+    overflow: hidden;
+}
+
+/* Switch records to cards whenever the panel itself becomes narrow. */
+@container audit-records (max-width: 1000px) {
+    .audit-table-shell {
+        overflow: visible;
+        padding: 0.72rem;
+        background: var(--audit-surface-subtle);
+    }
+
+    .audit-log-table,
+    .audit-log-table tbody {
+        display: block;
+        width: 100%;
+        min-width: 0;
+    }
+
+    .audit-log-table colgroup,
+    .audit-log-table thead {
+        display: none;
+    }
+
+    .audit-log-table tbody {
+        display: grid;
+        gap: 0.68rem;
+    }
+
+    .audit-log-table tr {
+        display: grid;
+        grid-template-columns: minmax(155px, 0.62fr) minmax(0, 1.38fr) auto;
+        gap: 0.72rem 0.85rem;
+        padding: 0.82rem;
+        border: 1px solid var(--audit-border);
+        border-radius: var(--audit-radius);
+        background: var(--audit-surface);
+        box-shadow: var(--audit-shadow-sm);
+    }
+
+    .audit-log-table tbody tr:hover {
+        background: var(--audit-surface);
+    }
+
+    .audit-log-table td {
+        display: block;
+        padding: 0;
+        border: 0 !important;
+    }
+
+    .audit-log-table td::before {
+        display: block;
+        margin-bottom: 0.35rem;
+        color: var(--audit-muted);
+        content: attr(data-label);
+        font-size: 0.61rem;
+        font-weight: 750;
+        letter-spacing: 0.05em;
+        text-transform: uppercase;
+    }
+
+    .audit-cell-time {
+        grid-column: 1;
+    }
+
+    .audit-cell-actor {
+        grid-column: 2 / -1;
+    }
+
+    .audit-cell-activity {
+        grid-column: 1 / -1;
+        padding-top: 0.7rem !important;
+        border-top: 1px solid var(--audit-border) !important;
+    }
+
+    .audit-cell-reference {
+        grid-column: 1 / 3;
+    }
+
+    .audit-cell-outcome {
+        grid-column: 3;
+    }
+
+    .audit-cell-action {
+        grid-column: 1 / -1;
+        text-align: left !important;
+    }
+
+    .audit-cell-action::before {
+        display: none !important;
+    }
+
+    .audit-row-action {
+        width: 100%;
+    }
+}
+
+/* Responsive organization */
+@media (max-width: 1280px) {
+    .audit-metrics {
+        grid-template-columns: repeat(3, minmax(0, 1fr));
+    }
+
+    .audit-advanced-grid {
+        grid-template-columns: repeat(3, minmax(150px, 1fr));
+    }
+}
+
+@media (max-width: 960px) {
+    .audit-page-header {
+        align-items: flex-start;
+        flex-direction: column;
+        gap: 0.8rem;
+    }
+
+    .audit-header-meta {
+        display: flex;
+        align-items: center;
+        justify-items: start;
+        flex-wrap: wrap;
+    }
+
+    .audit-primary-filters {
+        grid-template-columns: minmax(0, 1fr) minmax(0, 0.75fr) auto;
+    }
+
+    .audit-advanced-grid {
+        grid-template-columns: repeat(2, minmax(150px, 1fr));
+    }
+
+    .lifecycle-body {
+        grid-template-columns: 1fr;
+    }
+}
+
+@media (max-width: 760px) {
+    .audit-main {
+        padding-left: 0.8rem;
+        padding-right: 0.8rem;
+    }
+
+    .audit-page {
+        gap: 0.8rem;
+    }
+
+    .audit-metrics {
+        grid-template-columns: repeat(2, minmax(0, 1fr));
+        gap: 0.55rem;
+    }
+
+    .audit-metric {
+        padding: 0.72rem;
+    }
+
+    .audit-panel-header,
+    .lifecycle-head {
+        align-items: stretch;
+        flex-direction: column;
+        gap: 0.8rem;
+    }
+
+    .audit-panel-actions,
+    .lifecycle-badges {
+        max-width: none;
+        justify-content: flex-start;
+    }
+
+    .audit-primary-filters {
+        grid-template-columns: 1fr;
+    }
+
+    .audit-primary-submit {
+        width: 100%;
+    }
+
+    .audit-advanced-filters summary {
+        grid-template-columns: minmax(0, 1fr) auto auto;
+    }
+
+    .audit-advanced-description {
+        display: none;
+    }
+
+    .audit-advanced-grid {
+        grid-template-columns: 1fr;
+    }
+
+    .audit-advanced-footer,
+    .audit-active-filters,
+    .audit-results-bar,
+    .audit-pagination {
+        align-items: flex-start;
+        flex-direction: column;
+    }
+
+    .audit-advanced-footer > div,
+    .audit-panel-actions {
+        width: 100%;
+    }
+
+    .audit-advanced-footer .audit-btn,
+    .audit-panel-actions .audit-btn {
+        flex: 1 1 auto;
+    }
+
+    .audit-active-filters {
+        gap: 0.5rem;
+    }
+
+    .audit-filter-chips {
+        width: 100%;
+    }
+
+    .audit-results-meta {
+        justify-content: flex-start;
+    }
+
+    .audit-log-table tr {
+        grid-template-columns: minmax(0, 1fr) auto;
+    }
+
+    .audit-cell-time,
+    .audit-cell-actor,
+    .audit-cell-activity {
+        grid-column: 1 / -1;
+    }
+
+    .audit-cell-actor {
+        padding-top: 0.7rem !important;
+        border-top: 1px solid var(--audit-border) !important;
+    }
+
+    .audit-cell-reference {
+        grid-column: 1;
+    }
+
+    .audit-cell-outcome {
+        grid-column: 2;
+    }
+
+    .audit-detail-dialog {
+        width: calc(100vw - 1rem);
+        max-height: calc(100vh - 1rem);
+        border-radius: 13px;
+    }
+
+    .audit-detail-grid {
+        grid-template-columns: 1fr;
+    }
+
+    .audit-detail-grid > div,
+    .audit-detail-grid > div:nth-child(even) {
+        grid-column: 1;
+        border-right: 0;
+        border-bottom: 1px solid var(--audit-border);
+    }
+
+    .audit-detail-grid > div:last-child {
+        border-bottom: 0;
+    }
+
+    .audit-detail-grid > div:nth-last-child(-n + 2) {
+        border-bottom: 1px solid var(--audit-border);
+    }
+
+    .audit-detail-grid > div:last-child {
+        border-bottom: 0;
+    }
+
+    .duration-grid {
+        grid-template-columns: 1fr;
+    }
+}
+
+@media (max-width: 480px) {
+    .audit-metrics {
+        grid-template-columns: 1fr;
+    }
+
+    .audit-record-state,
+    .audit-latest {
+        white-space: normal;
+    }
+
+    .audit-advanced-footer > div,
+    .audit-panel-actions {
+        flex-direction: column;
+    }
+
+    .audit-filter-chip {
+        max-width: 100%;
+    }
+
+    .audit-log-table tr {
+        grid-template-columns: 1fr;
+    }
+
+    .audit-cell-reference,
+    .audit-cell-outcome {
+        grid-column: 1;
+    }
+
+    .timeline-top {
+        flex-direction: column;
+        gap: 0.2rem;
+    }
+
+    .timeline-top time {
+        white-space: normal;
+    }
+
+    .audit-dialog-header,
+    .audit-dialog-body,
+    .audit-dialog-footer {
+        padding-left: 0.9rem;
+        padding-right: 0.9rem;
+    }
+
+    .audit-metadata > div {
+        align-items: flex-start;
+        flex-direction: column;
+        gap: 0.2rem;
+    }
+}
+
+@media (prefers-reduced-motion: reduce) {
+    .audit-btn,
+    .audit-advanced-chevron,
+    .audit-input,
+    .audit-select,
+    .audit-log-table tbody tr {
+        transition: none;
+    }
+}
diff --git a/js/audit.js b/js/audit.js
new file mode 100644
--- /dev/null
+++ b/js/audit.js
@@ -0,0 +1,85 @@
+(() => {
+    'use strict';
+
+    const root = document.documentElement;
+    const isDialogElement = (value) => typeof Element !== 'undefined'
+        && value instanceof Element
+        && value.tagName === 'DIALOG';
+
+    const openDialog = (dialog) => {
+        if (!isDialogElement(dialog)) {
+            return;
+        }
+
+        if (typeof dialog.showModal === 'function') {
+            dialog.showModal();
+        } else {
+            dialog.setAttribute('open', '');
+        }
+
+        root.classList.add('audit-dialog-is-open');
+    };
+
+    const closeDialog = (dialog) => {
+        if (!isDialogElement(dialog)) {
+            return;
+        }
+
+        if (typeof dialog.close === 'function') {
+            dialog.close();
+        } else {
+            dialog.removeAttribute('open');
+            root.classList.remove('audit-dialog-is-open');
+        }
+    };
+
+    document.addEventListener('click', (event) => {
+        const target = event.target;
+        if (!(target instanceof Element)) {
+            return;
+        }
+
+        const opener = target.closest('[data-audit-dialog]');
+        if (opener) {
+            const dialogId = opener.getAttribute('data-audit-dialog');
+            const dialog = dialogId ? document.getElementById(dialogId) : null;
+            if (isDialogElement(dialog)) {
+                openDialog(dialog);
+            }
+            return;
+        }
+
+        const closer = target.closest('[data-audit-dialog-close]');
+        if (closer) {
+            closeDialog(closer.closest('dialog'));
+        }
+    });
+
+    document.querySelectorAll('.audit-detail-dialog').forEach((dialog) => {
+        dialog.addEventListener('close', () => {
+            if (!document.querySelector('.audit-detail-dialog[open]')) {
+                root.classList.remove('audit-dialog-is-open');
+            }
+        });
+
+        dialog.addEventListener('cancel', () => {
+            root.classList.remove('audit-dialog-is-open');
+        });
+
+        dialog.addEventListener('click', (event) => {
+            if (event.target !== dialog) {
+                return;
+            }
+
+            const bounds = dialog.getBoundingClientRect();
+            const outside = event.clientX < bounds.left
+                || event.clientX > bounds.right
+                || event.clientY < bounds.top
+                || event.clientY > bounds.bottom;
+
+            if (outside) {
+                closeDialog(dialog);
+            }
+        });
+    });
+})();
